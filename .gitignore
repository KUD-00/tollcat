# Xcode
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
DerivedData/
.derived/
build/
*.xcuserstate
*.moved-aside

# SwiftPM
.build/
.swiftpm/

# macOS
.DS_Store

# Agent/task scratch (screenshots, dumps)
tmp-task*/
.tmp-task*/
.cache/
# 设计审查技能的截图和 hook 缓存。
.impeccable/

# 凭据。真实 key 永远不进仓库。
.env
.env.*
*.p12
*.mobileprovision
secrets/

# Cloudflare Worker 本地产物
worker/node_modules/
worker/.wrangler/
worker/dist/
# `wrangler types` 的生成物，typecheck 前自动重生成。
worker/worker-configuration.d.ts

# wrangler 也会在仓库根写账号缓存，不是 worker/ 下面那份。
.wrangler/

# 落地页
site/node_modules/
site/dist/
site/.astro/
site/.wrangler/

# 本机 ops TUI（Ink + bun）
ops/node_modules/

# Android 壳（Swift .so 和 Gradle 产物都不进仓库）
Android/.gradle/
Android/.idea/
Android/.kotlin/
Android/*.iml
Android/build/
Android/app/build/
Android/app/src/main/jniLibs/
Android/local.properties
Android/native/.build/

# 跑 scripts/*.py 的闸会生成，别进仓库。
__pycache__/
*.pyc

# 签名归属只在本机 / CI 临时写出，见 Config/Signing.xcconfig
Config/Signing.local.xcconfig

# repo-atlas 的生成物（笔记、QA 档案、审计原文），只在本机，不进公开仓库
.atlas/

# 第三方 skill 的本地拷贝，不入库；.claude/skills/ 下自己写的可以提交
.claude/skills/impeccable/
