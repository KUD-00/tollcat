    "%@ 会立刻停止更新，你的投递脚本也会全部失效。已经存到本机的历史留着。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will stop updating immediately and all your ingest scripts will break. History already stored on this device stays."
