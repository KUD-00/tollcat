          }
        }
      }
    },
    "手表上的数都来自 iPhone。在 iPhone 上打开一次 TollCat，这里就有了。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything on your watch comes from your iPhone. Open TollCat there once and it’ll show up here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchの数字はすべてiPhoneから届きます。iPhoneでTollCatを一度開けば、ここにも表示されます。"
          }
        }
      }
    },
    "打开 iPhone 上的 TollCat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open TollCat on your iPhone"
