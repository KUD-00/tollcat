    <string name="inbox_prompt_rule_string">- The amount must be a string, never a JSON number — cents must not be lost</string>
    <string name="inbox_prompt_rule_period">- periodStart is always the 1st of the current month, and must roll over automatically</string>
    <string name="inbox_prompt_rule_overwrite">- Reporting twice in the same month overwrites rather than double-counts, so retries are safe</string>
