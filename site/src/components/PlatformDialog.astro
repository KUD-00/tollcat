---
import DevicePhoto from './DevicePhoto.astro';
import MenuBarStage from './MenuBarStage.astro';
import PhoneShot from './PhoneShot.astro';
import { siteConfig, type Locale } from '../config';
import { t, type PlatformDialogCopy, type PlatformShot } from '../i18n';
import type { PhoneShotPair } from '../screenshots';

type Props = {
  locale: Locale;
  platform: 'ipad' | 'mac' | 'android' | 'windows';
  shots: Partial<Record<PlatformShot, PhoneShotPair>>;
};
const { locale, platform, shots } = Astro.props;
const chrome = t(locale).platforms.dialog;
const copy: PlatformDialogCopy = chrome[platform];
const githubHref = siteConfig.githubUrl;
const titleId = `platform-dialog-title-${platform}`;
const ipadWidths = [480, 768, 1104, 1600, 2000];
const ipadPortraitWidths = [360, 720, 1080, 1422];
const macWidths = [480, 768, 1100, 1600, 2000];
const panelWidths = [320, 640];
const wideSizes = '(min-width: 720px) 36rem, 92vw';

function hrefFor(to: 'github' | undefined): string | undefined {
  if (to === 'github') return githubHref ?? undefined;
  return undefined;
}
---

<dialog
  class="support-dialog platform-dialog"
  aria-labelledby={titleId}
  data-platform-dialog={platform}
  data-page-template={chrome.page}
  data-page-a11y={chrome.pageA11y}
>
  <div class="support-sheet platform-sheet">
    <header class="support-sheet-bar">
      <h2 id={titleId}>{copy.title}</h2>
      {
        copy.slides.length > 1 && (
          <p class="trust-page" data-platform-page aria-live="polite">
            {chrome.page.replace('{current}', '1').replace('{total}', String(copy.slides.length))}
          </p>
        )
      }
      <button type="button" class="support-close" data-platform-close aria-label={chrome.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M6.2 6.2 17.8 17.8M17.8 6.2 6.2 17.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <div class="trust-body">
      <div class="trust-scroller" data-platform-scroller tabindex="0">
        {
          copy.slides.map((slide, index) => {
            const pair = slide.shot ? shots[slide.shot] : undefined;
            const href = hrefFor(slide.to);
            return (
              <article class="trust-slide platform-slide" data-platform-slide id={`platform-${platform}-slide-${index}`}>
                {
                  pair && slide.shot === 'dashboard' && (
                    <DevicePhoto class="platform-hero" pair={pair} widths={ipadWidths} sizes={wideSizes} />
                  )
                }
                {
                  pair && slide.shot === 'portrait' && (
                    <DevicePhoto
                      class="platform-hero platform-hero-portrait"
                      pair={pair}
                      widths={ipadPortraitWidths}
                      sizes="(min-width: 720px) 17rem, 60vw"
                    />
                  )
                }
                {
                  pair && slide.shot === 'window' && (
                    <DevicePhoto
                      class="platform-hero platform-hero-mac"
                      pair={pair}
                      widths={macWidths}
                      sizes={wideSizes}
                    />
                  )
                }
                {
                  pair && slide.shot === 'menubar' && (
                    <MenuBarStage class="platform-hero platform-hero-menubar" clock="9:41">
                      <PhoneShot
                        light={pair.light}
                        dark={pair.dark}
                        alt=""
                        widths={panelWidths}
                        sizes="(min-width: 720px) 20rem, 78vw"
                      />
                    </MenuBarStage>
                  )
                }
                <h3>{slide.title}</h3>
                {index === 0 && <p class="platform-lede">{copy.lede}</p>}
                {
                  index === 0 && copy.download && (
                    <p class="platform-download">
                      <a class="btn" href={siteConfig.macDownloadUrl} rel="noopener noreferrer">
                        {copy.download.label}
                      </a>
                      <span class="platform-download-note">{copy.download.note}</span>
                    </p>
                  )
                }
                {slide.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {href && slide.link && (
                  <p class="trust-slide-link">
                    <a href={href} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                      {slide.link}
                    </a>
                  </p>
                )}
              </article>
            );
          })
        }
      </div>
      {
        copy.slides.length > 1 && (
          <div class="trust-nav">
            <button type="button" class="trust-step" data-platform-prev aria-label={chrome.prev}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M14.5 6.5 9 12l5.5 5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <div class="trust-dots" role="group" aria-label={copy.title}>
              {copy.slides.map((slide, index) => (
                <button
                  type="button"
                  class="trust-dot"
                  data-platform-dot
                  aria-current={index === 0 ? 'true' : undefined}
                  aria-label={chrome.pageA11y
                    .replace('{current}', String(index + 1))
                    .replace('{total}', String(copy.slides.length))}
                >
                  <span class="sr-only">{slide.title}</span>
                </button>
              ))}
            </div>
            <button type="button" class="trust-step" data-platform-next aria-label={chrome.next}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M9.5 6.5 15 12l-5.5 5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>
</dialog>
