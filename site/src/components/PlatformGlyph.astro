---
/** 平台按钮上的小标：Apple（iPad / Mac 共用）、Android、Windows。
    都是实心填充的品牌轮廓，和 GitHubMark 一样走 currentColor。 */
type GlyphName = 'apple' | 'android' | 'windows';
type Props = { name: GlyphName; class?: string };
const { name, class: className } = Astro.props;

// 安卓机器人天生比苹果 / 窗格高一截，同一个 24 方框里会顶到上下边。
// 给它一个放大的 viewBox 缩回去，三个标在按钮上才一样重。
const boxes: Record<GlyphName, string> = {
  apple: '0 0 24 24',
  android: '-3 -3 30 30',
  windows: '0 0 24 24',
};

const paths: Record<GlyphName, string> = {
  apple:
    'M17.16 12.66c-.02-2.3 1.88-3.4 1.96-3.45-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.75 2.97-.75 1.39 0 1.78.75 2.99.72 1.24-.02 2.02-1.12 2.78-2.23.87-1.28 1.23-2.51 1.25-2.58-.03-.01-2.4-.93-2.42-3.68ZM14.9 5.55c.64-.77 1.06-1.84.95-2.9-.91.04-2.01.6-2.67 1.37-.58.68-1.1 1.77-.96 2.8 1.02.08 2.05-.51 2.68-1.27Z',
  android:
    'M15.6 2.2 16.9.9a.5.5 0 0 0-.71-.7L14.7 1.68A6.9 6.9 0 0 0 12 1.15c-.96 0-1.87.19-2.68.53L7.83.2a.5.5 0 0 0-.71.7l1.3 1.3A6.4 6.4 0 0 0 5.6 7.4h12.8a6.4 6.4 0 0 0-2.8-5.2ZM9.9 5.1a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Zm4.2 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4ZM3.6 8.4a1.5 1.5 0 0 0-1.5 1.5v5.9a1.5 1.5 0 1 0 3 0V9.9a1.5 1.5 0 0 0-1.5-1.5Zm16.8 0a1.5 1.5 0 0 0-1.5 1.5v5.9a1.5 1.5 0 1 0 3 0V9.9a1.5 1.5 0 0 0-1.5-1.5ZM5.9 17.4c0 .77.63 1.4 1.4 1.4h.8v3.2a1.5 1.5 0 1 0 3 0v-3.2h1.8v3.2a1.5 1.5 0 1 0 3 0v-3.2h.8c.77 0 1.4-.63 1.4-1.4V8.6H5.9v8.8Z',
  windows: 'M3 5.55 10.35 4.5v7.05H3Zm8.4-1.2L21 3v8.55h-9.6ZM3 12.45h7.35v7.05L3 18.45Zm8.4 0H21V21l-9.6-1.35Z',
};
---

<svg class:list={['platform-glyph', className]} viewBox={boxes[name]} aria-hidden="true" focusable="false">
  <path fill="currentColor" d={paths[name]}></path>
</svg>
