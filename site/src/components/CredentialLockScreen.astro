---
import { providerMarks } from '../providers';
import ProviderGlyph from './ProviderGlyph.astro';

type Props = { label: string };
const { label } = Astro.props;

const lockKeys = ['openai', 'aws', 'cloudflare', 'github', 'anthropic', 'vercel'] as const;
const lockMarks = lockKeys.map((key) => {
  const mark = providerMarks.find((item) => item.key === key);
  if (!mark) throw new Error(`CredentialLockScreen: missing provider ${key}`);
  return mark;
});
---

<div class="lock-stage" data-lock-stage role="img" aria-label={label}>
  <div class="lock-status" aria-hidden="true">
    <span class="lock-time">9:41</span>
    <span class="lock-island"></span>
    <span class="lock-status-end">
      <svg viewBox="0 0 18 12" class="lock-signal">
        <rect x="0" y="8" width="3" height="4" rx="0.6" fill="currentColor"></rect>
        <rect x="5" y="5.5" width="3" height="6.5" rx="0.6" fill="currentColor"></rect>
        <rect x="10" y="3" width="3" height="9" rx="0.6" fill="currentColor"></rect>
        <rect x="15" y="0.5" width="3" height="11.5" rx="0.6" fill="currentColor"></rect>
      </svg>
      <svg viewBox="0 0 16 12" class="lock-wifi">
        <path
          d="M1.2 4.6a10 10 0 0 1 13.6 0M3.6 7a6.4 6.4 0 0 1 8.8 0M8 11.1a1.15 1.15 0 1 1 0-2.3 1.15 1.15 0 0 1 0 2.3Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linecap="round"></path>
      </svg>
      <svg viewBox="0 0 27 12" class="lock-battery">
        <rect x="0.6" y="1.6" width="22" height="8.8" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.2"
        ></rect>
        <rect x="2.2" y="3.2" width="16.6" height="5.6" rx="1" fill="currentColor"></rect>
        <rect x="23.4" y="4.1" width="2.2" height="3.8" rx="0.7" fill="currentColor"></rect>
      </svg>
    </span>
  </div>

  <div class="lock-field" aria-hidden="true">
    <div class="lock-gather">
      <div class="lock-spin">
        {
          lockMarks.map((mark, index) => (
            <span class="lock-mark" style={`--a:${-90 + index * 60}deg`}>
              <span class="lock-mark-inner">
                <ProviderGlyph mark={mark} />
              </span>
            </span>
          ))
        }
      </div>
    </div>

    <div class="lock-seal">
      <span class="lock-glyph">
        <svg class="lock-shackle" viewBox="0 0 64 64">
          <path
            d="M21 36V20A11 11 0 0 1 43 20V36H38V20A6 6 0 0 0 26 20V36Z"
            fill="currentColor"
            fill-rule="evenodd"
          ></path>
        </svg>
        <svg class="lock-body" viewBox="0 0 64 64">
          <rect x="12" y="27" width="40" height="28" rx="8" fill="currentColor"></rect>
        </svg>
      </span>
    </div>
  </div>
</div>
