---
type Props = { class?: string; clock: string };
const { class: className, clock } = Astro.props;
---

<figure class:list={['menubar-stage', className]}>
  <div class="menubar-strip" aria-hidden="true">
    <span class="menubar-left">TollCat</span>
    <span class="menubar-right">
      <svg class="menubar-cat" viewBox="0 0 32 32" focusable="false">
        <path
          d="M8.2 9.4c1.1 2.1 1.9 2.4 3.4 2.5 1.8-.5 4.6-.5 6.4 0 1.5-.1 2.3-.4 3.4-2.5 1.4 2.3 3.8 4.4 4.5 8.6.7 5.2-.9 10-5.8 11.4-2.8.8-7.6.8-10.4 0-4.9-1.4-6.5-6.2-5.8-11.4.7-4.2 3.1-6.3 4.5-8.6z"
          fill="currentColor"></path>
        <path
          class="menubar-cat-eyes"
          d="M12.2 18.4c.4 1.5.8 1.9 2.2 2.3-1.5.4-1.8.8-2.2 2.3-.4-1.5-.8-1.9-2.2-2.3 1.5-.4 1.8-.8 2.2-2.3zm7.6 0c.4 1.5.8 1.9 2.2 2.3-1.5.4-1.8.8-2.2 2.3-.4-1.5-.8-1.9-2.2-2.3 1.5-.4 1.8-.8 2.2-2.3z"></path>
      </svg>
      <span class="menubar-clock">{clock}</span>
    </span>
  </div>
  <div class="menubar-panel">
    <slot />
  </div>
</figure>
