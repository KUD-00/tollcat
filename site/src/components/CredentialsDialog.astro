---
import { localePath, siteConfig, type Locale } from '../config';
import { t } from '../i18n';
import credentialsDialogUrl from '../scripts/credentials-dialog.js?url';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy = t(locale).credentials.dialog;
const privacyHref = localePath(locale, 'privacy');
const githubHref = siteConfig.githubUrl;
const verifyHref = githubHref ? `${githubHref}/blob/main/VERIFY.md` : null;

function hrefFor(to: 'github' | 'privacy' | 'verify' | undefined): string | undefined {
  if (to === 'github') return githubHref ?? undefined;
  if (to === 'privacy') return privacyHref;
  if (to === 'verify') return verifyHref ?? undefined;
  return undefined;
}
---

<dialog
  class="support-dialog trust-dialog"
  aria-labelledby="trust-dialog-title"
  data-trust-dialog
  data-page-template={copy.page}
  data-page-a11y={copy.pageA11y}
>
  <div class="support-sheet trust-sheet">
    <header class="support-sheet-bar">
      <h2 id="trust-dialog-title">{copy.title}</h2>
      <p class="trust-page" data-trust-page aria-live="polite">
        {copy.page.replace('{current}', '1').replace('{total}', String(copy.slides.length))}
      </p>
      <button type="button" class="support-close" data-trust-close aria-label={copy.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M6.2 6.2 17.8 17.8M17.8 6.2 6.2 17.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <div class="trust-body">
      <div class="trust-scroller" data-trust-scroller tabindex="0">
        {
          copy.slides.map((slide, index) => {
            const href = hrefFor(slide.to);
            return (
              <article class="trust-slide" data-trust-slide id={`trust-slide-${index}`}>
                <h3>{slide.title}</h3>
                {slide.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {href && slide.link && (
                  <p class="trust-slide-link">
                    <a
                      href={href}
                      rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      {slide.link}
                    </a>
                  </p>
                )}
              </article>
            );
          })
        }
      </div>
      <div class="trust-nav">
        <button type="button" class="trust-step" data-trust-prev aria-label={copy.prev}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M14.5 6.5 9 12l5.5 5.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="trust-dots" role="group" aria-label={copy.title}>
          {
            copy.slides.map((slide, index) => (
              <button
                type="button"
                class="trust-dot"
                data-trust-dot
                aria-current={index === 0 ? 'true' : undefined}
                aria-label={copy.pageA11y
                  .replace('{current}', String(index + 1))
                  .replace('{total}', String(copy.slides.length))}
              >
                <span class="sr-only">{slide.title}</span>
              </button>
            ))
          }
        </div>
        <button type="button" class="trust-step" data-trust-next aria-label={copy.next}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M9.5 6.5 15 12l-5.5 5.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</dialog>
<script is:inline type="module" src={credentialsDialogUrl}></script>
