# HTML 的 no-transform 挡住 Cloudflare Web Analytics 插 beacon。不要写在 /* 上，会跟 /_astro 的 immutable 拼成一条 Cache-Control。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.tollcat.app; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
