{
  "name": "TollCat",
  "short_name": "TollCat",
  "description": "One number for every cloud and AI bill.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#E6E8EE",
  "theme_color": "#5856D6",
  "lang": "zh-Hans",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
